{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Staging": "Server=.;Database=EduFlow_Staging;Integrated Security=True;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30",
    "Warehouse": "Server=.;Database=EduFlow_DW;Integrated Security=True;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30"
  },
  "Jwt": {
    "Issuer": "EduFlow",
    "Audience": "EduFlow.Clients",
    "Secret": "DEV_ONLY_CHANGE_IN_PRODUCTION_MIN_32_CHARS",
    "ExpirationMinutes": 480
  },
  "Ops": {
    "WorkersHealthUrl": "http://localhost:5055/health/live",
    "RabbitManagementUrl": "http://127.0.0.1:15672",
    "FrontendUrl": "http://localhost:3000",
    "ApiSwaggerUrl": "http://localhost:8080/swagger"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "eduflow",
    "Password": "eduflow_secret",
    "Exchange": "eduflow.events"
  },
  "SyncScheduler": {
    "Enabled": true,
    "PollIntervalSeconds": 60,
    "DefaultIntervalMinutes": 15,
    "EntityTypes": ["students", "financial", "contracts"]
  },
  "ErpConnectors": {
    "AllowDemoFallback": false
  },
  "Cors": {
    "Origins": ["http://localhost:3000"]
  },
  "Pilot": {
    "AllowRegistration": false
  },
  "AllowedHosts": "*"
}
