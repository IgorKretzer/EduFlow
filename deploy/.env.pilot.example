# Copie para deploy/.env.pilot e preencha (nunca commite .env.pilot).
# Uso: cp deploy/.env.pilot.example deploy/.env.pilot

# --- SQL Server (container pilot) ---
MSSQL_SA_PASSWORD=TroquePorSenhaForte123!

# --- RabbitMQ ---
RABBITMQ_USER=eduflow
RABBITMQ_PASSWORD=TroquePorSenhaForte456!

# --- API (Production) ---
Jwt__Secret=GERE_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
Cors__Origins__0=https://SEU-PROJETO.vercel.app

# Só na primeira configuração: permitir criar escola/usuário via POST /api/auth/register
# Depois de criar o tenant, volte para false e reinicie a API.
Pilot__AllowRegistration=true

# Produção: sem dados fictícios do Sponte quando o ERP falha
ErpConnectors__AllowDemoFallback=false

# --- HTTPS (Caddy) — opcional ---
# Com domínio apontando para o IP da VM: API_DOMAIN=api.suaescola.com.br
# Sem domínio: deixe vazio (Caddy expõe HTTP na porta 80 com o IP público).
API_DOMAIN=
ACME_EMAIL=seu-email@dominio.com

# --- Vercel (configure no painel da Vercel, não neste arquivo) ---
# NEXT_PUBLIC_API_URL=https://api.suaescola.com.br  (HTTPS obrigatório com front na Vercel)
