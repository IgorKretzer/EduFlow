# Produção beta 1.0.0 — copie para deploy/.env.production (nunca commitar).
# cp deploy/.env.production.example deploy/.env.production && chmod 600 deploy/.env.production
#
# IMPORTANTE: Connection strings com "User ID" têm ESPAÇO — use aspas simples '...'
# senão: source do .env quebra com "User: command not found"

EDUFLOW_SQL_TARGET=azure

AZURE_SQL_FQDN=seu-servidor.database.windows.net
AZURE_SQL_USER=eduflowadmin
AZURE_SQL_PASSWORD='coloque-senha-entre-aspas-se-tiver-caracteres-especiais'

ConnectionStrings__Staging='Server=tcp:seu-servidor.database.windows.net,1433;Database=EduFlow_Staging;User ID=eduflowadmin;Password=TROQUE;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;'
ConnectionStrings__Warehouse='Server=tcp:seu-servidor.database.windows.net,1433;Database=EduFlow_DW;User ID=eduflowadmin;Password=TROQUE;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;'

# --- SQL em container (EDUFLOW_SQL_TARGET=local-sql, VM >= 2 GB) ---
# Com azure=NÃO precisa de MSSQL_SA_PASSWORD. Se o compose reclamar, adicione: MSSQL_SA_PASSWORD=unused
# MSSQL_SA_PASSWORD=
# ConnectionStrings__Staging='Server=sqlserver,1433;Database=EduFlow_Staging;User Id=sa;Password=...;TrustServerCertificate=True;Encrypt=True'
# ConnectionStrings__Warehouse='Server=sqlserver,1433;Database=EduFlow_DW;User Id=sa;Password=...;TrustServerCertificate=True;Encrypt=True'

RABBITMQ_USER=eduflow
RABBITMQ_PASSWORD=
# Multi-VM: nas VMs de API/Workers, use o IP privado da VM RabbitMQ.
# Na VM RabbitMQ este valor nao e necessario para subir a fila.
RABBITMQ_HOST=10.0.0.10
RABBITMQ_PORT=5672
# Segurança de rede RabbitMQ:
# - RABBITMQ_BIND_IP=0.0.0.0 publica AMQP em todas interfaces; restrinja no firewall/NSG.
# - RABBITMQ_MANAGEMENT_BIND_IP=127.0.0.1 deixa a UI acessível só via SSH tunnel.
RABBITMQ_BIND_IP=0.0.0.0
RABBITMQ_MANAGEMENT_BIND_IP=127.0.0.1

# Workers podem ser separados por função em VMs diferentes.
# Para uma única VM de workers, mantenha tudo true.
WORKERS_ENABLE_STUDENTS=true
WORKERS_ENABLE_FINANCIAL=true
WORKERS_ENABLE_CONTRACTS=true
WORKERS_ENABLE_ANALYTICS=true
WORKERS_ENABLE_SCHEDULER=true

Jwt__Secret=
Cors__Origins__0=https://seu-app.vercel.app

Pilot__AllowRegistration=false
ErpConnectors__AllowDemoFallback=false

API_DOMAIN=api.seudominio.com
ACME_EMAIL=admin@seudominio.com
