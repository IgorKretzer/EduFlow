# URL da API EduFlow (.NET)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Versão exibida no menu lateral
NEXT_PUBLIC_APP_VERSION=1.0.0-beta

# Produção beta (Vercel): https://api... — guia docs/PRODUCAO-BETA.md

# Painel operacional (RabbitMQ/filas) — false para gestores; true só em dev/suporte
NEXT_PUBLIC_SHOW_OPS_PANEL=false

# Botão "Criar ambiente demo" no login — false na Vercel / piloto
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
